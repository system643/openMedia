{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openMedia",
  "version": "0.1.0",
  "identifier": "app.openmedia.journal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1427",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "openMedia",
        "url": "index.html",
        "width": 1240,
        "height": 820,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false
      },
      {
        "label": "bulle",
        "title": "openMedia — languette",
        "url": "bulle.html",
        "width": 7,
        "height": 60,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "dragDropEnabled": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Ton journal personnel agentique",
    "category": "News",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  },
  "plugins": {}
}
